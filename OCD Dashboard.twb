    <worksheet name='side by side bar'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Y-BOCS Scores across age groups</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ocd_patient_dataset' name='federated.0edmv9f1p93j4v10pi7yj1tigr08' />
