        <calculation class='tableau' formula='if [Age] &gt; 0 and [Age] &lt;= 10 then &quot;0 - 10&quot;&#13;&#10;ELSEIF [Age] &gt; 10 and [Age] &lt;= 20 then &quot;11 - 20&quot;&#13;&#10;elseif [Age] &gt; 20 and [Age] &lt;= 30 then &quot;21 - 30&quot;&#13;&#10;elseif [Age] &gt; 30 and [Age] &lt;= 40 then &quot;31 - 40&quot;&#13;&#10;elseif [Age] &gt; 40 and [Age] &lt;= 50 then &quot;41 - 50&quot;&#13;&#10;elseif [Age] &gt; 50 and [Age] &lt;= 60 then &quot;51 - 60&quot;&#13;&#10;elseif [Age] &gt; 60 and [Age] &lt;= 70 then &quot;61 - 70&quot;&#13;&#10;elseif [Age] &gt; 70 and [Age] &lt;= 80 then &quot;71 - 80&quot;&#13;&#10;elseif [Age] &gt; 80 and [Age] &lt;= 90 then &quot;81 - 90&quot;&#13;&#10;elseif [Age] &gt; 90 and [Age] &lt;= 100 then &quot;91 - 100&quot;&#13;&#10;END' />
